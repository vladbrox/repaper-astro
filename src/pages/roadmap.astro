---
import Layout from "@/layouts/main.astro"
import { Badge } from "@/components/ui/badge"
import { Button } from "@/components/ui/button"
---

<Layout>
  <div class="max-w-xl mx-auto px-4 pt-32 pb-20 text-left">

    <h1 class="text-5xl font-black tracking-tight text-center">Roadmap</h1>
    <p class="mt-3 text-xl text-muted-foreground text-center">
      What's coming next for repaper (last updated: August 2026)
    </p>
    <div class="mt-12 flex flex-col gap-10">

        <!-- 1. Completed -->
        <div class="flex flex-col gap-2">
          <h2 class="text-xl font-bold text-foreground">
            1. Core mvp
            <span class="inline-flex items-center align-middle ml-2 px-2.5 py-0.5 text-xs font-semibold rounded-full bg-emerald-500 text-white shadow-sm shadow-emerald-500/20 whitespace-nowrap">
                Done
            </span>
          </h2>
          <p class="text-lg text-muted-foreground leading-relaxed">
              Where it started: basic features and core backend.
          </p>
        </div>

        <div class="flex flex-col gap-2">
          <h2 class="text-xl font-bold text-foreground">
            2. Early Alpha
            <span class="inline-flex items-center align-middle ml-2 px-2.5 py-0.5 text-xs font-semibold rounded-full bg-sky-500 text-white shadow-sm shadow-sky-500/20 whitespace-nowrap">
              In Progress
            </span>
          </h2>
          <p class="text-lg text-muted-foreground leading-relaxed">
              Initial launch of repaperbot in Telegram. Core engine for noise-free AI summarization and preset management.
          </p>
        </div>

        <div class="flex flex-col gap-2">
          <h2 class="text-xl font-bold text-foreground">
              3. Ecosystem Expansion
            <span class="inline-flex items-center align-middle ml-2 px-2.5 py-0.5 text-xs font-medium rounded-full bg-zinc-700/80 text-zinc-200 border border-zinc-600/50 whitespace-nowrap">
                Planned
            </span>
          </h2>
          <p class="text-lg text-muted-foreground leading-relaxed">
              Integrating extra sources like RSS, YouTube, and Steam with advanced ad and noise filtering.
          </p>
        </div>

    </div>

    <div class="mt-20 flex flex-col sm:flex-row items-center justify-center gap-4">
      <h2 class="text-xl font-bold tracking-tight">Have an idea?</h2>

      <a href="https://t.me/getrepaper?direct" target="_blank">
        <Button variant="outline" className="rounded-full font-medium">
          Send Feedback in Telegram
        </Button>
      </a>
    </div>

  </div>
</Layout>
