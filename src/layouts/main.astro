---
import "@/styles/global.css"
import Header from "@/components/Header.astro"

interface Props {
  title?: string
  description?: string
}

const {
  title = "repaper — take back your attention",
  description = "Stop endless scrolling. repaper turns your entire information feed into a clean AI summary — right inside Telegram.",
} = Astro.props

const siteUrl = "https://repaper.jkoder.cc"
const ogImage = `${siteUrl}/og-image.png`
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, siteUrl)} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={new URL(Astro.url.pathname, siteUrl)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <Header></Header>
    <main><slot /></main>

    <footer class="w-full mt-16 py-8 border-t border-border/40 font-[550]">
      <div class="max-w-xl mx-auto px-6 flex items-center justify-center gap-3 text-sl">
        <span>© 2026 repaper</span>
        <span class="opacity-40">•</span>
        <span class="hidden sm:inline">take back your attention</span>
        <span class="hidden sm:inline opacity-40">•</span>
        <a href="/roadmap" class="hover:text-foreground transition-colors underline underline-offset-4">
          roadmap
        </a>
      </div>
    </footer>
  </body>
</html>
